# ==============================================================================
# GlyphCraft SaaS Environment Variables Reference
# Copy relevant sections into:
#   - apps/web/.env.local          (VITE_* variables)
#   - apps/api/.dev.vars           (Cloudflare Workers local secrets)
#   - Modal Secret: glyphcraft-secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (apps/web/.env.local)
# ------------------------------------------------------------------------------
VITE_BRAND_NAME=GlyphCraft
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Cloudflare Turnstile test sitekey (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_PRICE_DISPLAY=$9

# ------------------------------------------------------------------------------
# 2. Backend API - Cloudflare Workers (apps/api/.dev.vars & wrangler secrets)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEV_BYPASS_TURNSTILE=true
BRAND_NAME=GlyphCraft
FRONTEND_URL=http://localhost:5173
FREE_PREVIEW_DAILY_LIMIT=3
FONT_PRICE_CENTS=900

# Shared internal secret between Workers and Modal
INTERNAL_API_SECRET=replace-with-strong-random-hex-secret

# Modal ASGI Web Endpoint (from `modal deploy modal_inference/app.py`)
MODAL_API_BASE_URL=https://your-modal-workspace--glyphcraft-inference-web-api.modal.run

# Cloudflare Turnstile Secret (test secret: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare R2 S3 Presign Credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=glyphcraft-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Creem Payments
CREEM_API_BASE=https://test-api.creem.io
CREEM_API_KEY=creem_test_your_api_key
CREEM_PRODUCT_ID=prod_your_product_id
CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend Transactional Email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=GlyphCraft <fonts@yourdomain.com>

# ------------------------------------------------------------------------------
# 3. Modal Inference Secrets (Modal Secret name: glyphcraft-secrets)
# ------------------------------------------------------------------------------
# INTERNAL_API_SECRET=same-secret-as-workers
# WORKERS_CALLBACK_URL=https://api.yourdomain.com/api/internal/modal-callback
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=glyphcraft-assets
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# WEIGHTS_SUBDIR=font_en_128
